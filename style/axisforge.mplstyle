# AxisForge -- house paper style for report and thesis figures (accepted by Jose 2026-10-17).
# Derived from the classic contact/EHL papers (Johnson 1985, Venner & Bos 1994, Nijenbanning 1994,
# Polonsky & Keer 1999, Mueser 2017). One file decides how every figure looks; figure functions
# only pass data. Load with: matplotlib.pyplot.style.use("<repo>/style/axisforge.mplstyle")
# Semantics (set per plot, not here): numerical result = filled markers; formula/theory = lines
# (own solid, others dashed/dotted); published/experiment = open markers. Colour never carries
# identity alone. See style/README.md.

# --- figure / export ---
figure.figsize      : 5.9, 3.7        # 150 x 95 mm full width; single column 3.15 x 2.45 in
figure.dpi          : 110
figure.constrained_layout.use : True
savefig.dpi         : 300
savefig.format      : pdf
savefig.bbox        : tight
savefig.pad_inches  : 0.02
pdf.fonttype        : 42
svg.fonttype        : none

# --- typography ---
font.family         : serif
font.serif          : STIX Two Text, STIXGeneral, Times New Roman, DejaVu Serif
mathtext.fontset    : stix
font.size           : 9
axes.titlesize      : 9
axes.titleweight    : normal          # no bold titles: captions live in LaTeX
axes.labelsize      : 9
legend.fontsize     : 8
xtick.labelsize     : 8
ytick.labelsize     : 8

# --- colour: black first (reference / own result), then 4 dark CVD-checked hues ---
# validated 2026-10-17 (validate_palette.js, light): 2a5caa, c4561b, 178a73, 8a4fa8 all PASS
axes.prop_cycle     : cycler('color', ['000000', '2a5caa', 'c4561b', '178a73', '8a4fa8']) + cycler('linestyle', ['-', '--', '-.', ':', (0, (5, 1, 1, 1, 1, 1))])
text.color          : 000000
axes.labelcolor     : 000000
axes.edgecolor      : 000000
xtick.color         : 000000
ytick.color         : 000000

# --- axes: closed box, inward ticks on four sides, minor ticks, no grid ---
axes.spines.top     : True
axes.spines.right   : True
axes.linewidth      : 0.6
axes.grid           : False
axes.axisbelow      : True
axes.formatter.use_mathtext : True
axes.formatter.limits : -3, 4
xtick.direction     : in
ytick.direction     : in
xtick.top           : True
ytick.right         : True
xtick.major.size    : 3.5
ytick.major.size    : 3.5
xtick.major.width   : 0.6
ytick.major.width   : 0.6
xtick.minor.visible : True
ytick.minor.visible : True
xtick.minor.size    : 2
ytick.minor.size    : 2
xtick.minor.width   : 0.5
ytick.minor.width   : 0.5

# --- marks ---
lines.linewidth     : 1.0
lines.color         : 000000          # lines without a colour, and contours drawn with colors=rcParams["lines.color"]
lines.markersize    : 4
lines.markeredgewidth : 0.7
lines.solid_capstyle: round
errorbar.capsize    : 2
contour.linewidth   : 0.6
contour.negative_linestyle : dashed
image.cmap          : cividis

# --- legend: frameless, prefer direct labels ---
legend.frameon      : False
legend.handlelength : 2.0
legend.borderaxespad: 0.3
